generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  GESTOR_ADMIN
  OPERADOR
}

model Gestor {
  id           String            @id @default(uuid())
  nome         String
  razaoSocial  String?
  email        String?           @unique
  celular      String?
  tipoPessoa   String            @default("JURIDICA")
  documento    String?           @unique
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  estado       String?
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  usuarios     Usuario[]
  condominios  Condominio[]
  movimentos   MovimentoMensal[]
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      Role     @default(OPERADOR)
  gestorId  String?
  gestor    Gestor?  @relation(fields: [gestorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gestorId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@map("password_reset_tokens")
}

model Condominio {
  id              String          @id @default(cuid())
  cnpj            String          @unique
  nome            String
  endereco        String
  email           String
  celular         String
  gestorId        String?
  gestor          Gestor?         @relation(fields: [gestorId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  blocos          Bloco[]
  unidades        Unidade[]
  despesasMensais DespesaMensal[]
  tiposUnidade    TipoUnidade[]
  tiposDespesa    TipoDespesa[]
  movimentos      MovimentoMensal[]

  @@index([gestorId])
}

model Bloco {
  id              String          @id @default(cuid())
  nome            String
  condominioId    String
  condominio      Condominio      @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  unidades        Unidade[]
  tiposUnidade    TipoUnidade[]
  tiposDespesa    TipoDespesa[]
  despesasMensais DespesaMensal[]

  @@unique([nome, condominioId])
  @@index([condominioId])
}

model TipoUnidade {
  id           String              @id @default(cuid())
  nome         String
  blocoId      String
  bloco        Bloco               @relation(fields: [blocoId], references: [id], onDelete: Restrict)
  condominioId String
  condominio   Condominio          @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  unidades     Unidade[]
  regras       RegraParticipacao[]

  @@unique([nome, condominioId, blocoId])
  @@index([condominioId])
  @@index([blocoId])
}

model Unidade {
  id            String      @id @default(cuid())
  numero        String
  nomeMorador   String      @default("")
  celular       String      @default("")
  tipoUnidadeId String
  tipoUnidade   TipoUnidade @relation(fields: [tipoUnidadeId], references: [id], onDelete: Restrict)
  tipoConsumo   String      @default("Água/Gás")
  blocoId       String
  bloco         Bloco       @relation(fields: [blocoId], references: [id], onDelete: Restrict)
  condominioId  String
  condominio    Condominio  @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  leituras       Leitura[]
  leiturasAgua   LeituraAgua[]
  leiturasGas    LeituraGas[]
  faturas        FaturaUnidade[]
  historicoMoradores HistoricoMorador[]

  @@unique([condominioId, blocoId, numero])
  @@index([condominioId])
  @@index([blocoId])
}

model HistoricoMorador {
  id          String    @id @default(cuid())
  unidadeId   String
  unidade     Unidade   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  nomeMorador String
  email       String    @default("")
  celular     String    @default("")
  dataEntrada DateTime
  dataSaida   DateTime?

  @@index([unidadeId])
  @@index([unidadeId, dataEntrada])
}

model Leitura {
  id        String   @id @default(cuid())
  unidadeId String
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  mes       Int
  ano       Int
  valorAgua Float?
  valorGas  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadeId, mes, ano])
}

model LeituraAgua {
  id           String   @id @default(cuid())
  dataLeitura  DateTime
  valorLeitura Float
  unidadeId    String
  unidade      Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  mes          Int
  ano          Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([unidadeId])
  @@index([unidadeId, dataLeitura])
}

model LeituraGas {
  id           String   @id @default(cuid())
  dataLeitura  DateTime
  valorLeitura Float
  unidadeId    String
  unidade      Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  mes          Int
  ano          Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([unidadeId])
  @@index([unidadeId, dataLeitura])
}

model TipoDespesa {
  id           String              @id @default(cuid())
  nome         String
  blocoId      String
  bloco        Bloco               @relation(fields: [blocoId], references: [id], onDelete: Restrict)
  condominioId String
  condominio   Condominio          @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  despesas     DespesaMensal[]
  regras       RegraParticipacao[]

  @@unique([nome, condominioId, blocoId])
  @@index([condominioId])
  @@index([blocoId])
}

model DespesaMensal {
  id            String      @id @default(cuid())
  blocoId       String
  bloco         Bloco       @relation(fields: [blocoId], references: [id], onDelete: Restrict)
  mes           Int
  ano           Int
  valorTotal    Float
  valorFixo     Float?
  valorVariavel Float?
  formaCobranca String
  condominioId  String
  condominio    Condominio  @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  tipoDespesaId String
  tipoDespesa   TipoDespesa @relation(fields: [tipoDespesaId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([condominioId, blocoId, mes, ano, tipoDespesaId])
  @@index([condominioId])
  @@index([blocoId])
}

model MovimentoMensal {
  id           String     @id @default(cuid())
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  gestorId     String
  gestor       Gestor     @relation(fields: [gestorId], references: [id], onDelete: Restrict)
  mes          Int
  ano          Int
  fechado      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([condominioId, mes, ano])
  @@unique([mes, ano, gestorId])
  @@index([condominioId])
  @@index([gestorId])
}

model FaturaUnidade {
  id           String   @id @default(cuid())
  unidadeId    String
  unidade      Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  mes          Int
  ano          Int
  valorAgua    Float    @default(0)
  valorEnergia Float    @default(0)
  valorGas     Float    @default(0)
  valorOutras  Float    @default(0)
  valorTotal   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([unidadeId, mes, ano])
}

model RegraParticipacao {
  id            String      @id @default(cuid())
  tipoUnidadeId String
  tipoDespesaId String
  tipoUnidade   TipoUnidade @relation(fields: [tipoUnidadeId], references: [id], onDelete: Cascade)
  tipoDespesa   TipoDespesa @relation(fields: [tipoDespesaId], references: [id], onDelete: Cascade)

  @@unique([tipoUnidadeId, tipoDespesaId])
}
