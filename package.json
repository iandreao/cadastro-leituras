{
  "name": "cadastro-leituras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/liberar-porta.mjs 3001 && next dev --port 3001",
    "build": "prisma generate && next build",
    "deploy": "node scripts/liberar-porta.mjs 3001 && prisma generate && npx tsc --noEmit && npm run build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:limpar-leituras": "tsx src/lib/limpar-leituras.ts",
    "prisma:fresh": "node scripts/prisma-fresh.mjs",
    "postinstall": "node scripts/prisma-fresh.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
